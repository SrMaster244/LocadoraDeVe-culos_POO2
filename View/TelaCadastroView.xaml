<UserControl x:Class="LocadoraDeVeículos.TelaCadastroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="CADASTRO" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Tipo Pessoa:" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <RadioButton x:Name="rdbPessoaFisica" Content="Física" IsChecked="True" GroupName="TipoPessoa" Checked="TipoPessoaChanged" Margin="0,0,20,0"/>
            <RadioButton x:Name="rdbPessoaJuridica" Content="Jurídica" GroupName="TipoPessoa" Checked="TipoPessoaChanged"/>
        </StackPanel>
        <Grid Grid.Row="2" Width="500" HorizontalAlignment="Center" Margin="0,25">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Label Content="Nome:" Grid.Row="0"/>
            <TextBox x:Name="txtNome" Grid.Row="0" Grid.Column="1" Margin="5"/>
            <Label x:Name="lblDocumento" Content="CPF:" Grid.Row="1"/>
            <TextBox x:Name="txtDocumento" Grid.Row="1" Grid.Column="1" Margin="5"/>
            <Label Content="Email:" Grid.Row="2"/>
            <TextBox x:Name="txtEmail" Grid.Row="2" Grid.Column="1" Margin="5"/>
            <Label Content="CEP:" Grid.Row="3"/>
            <TextBox x:Name="txtCep" Grid.Row="3" Grid.Column="1" Margin="5"/>
            <Label x:Name="lblData" Content="Data de Nascimento:" Grid.Row="4"/>
            <DatePicker x:Name="dtpData" Grid.Row="4" Grid.Column="1" Margin="5"/>
        </Grid>
        <Button x:Name="btnCadastro" Grid.Row="3" Content="BTN CADASTRO" Width="180" Height="38" HorizontalAlignment="Center" Click="BtnCadastro_Click"/>
    </Grid>
</UserControl>
