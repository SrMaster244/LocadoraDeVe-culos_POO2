<UserControl x:Class="LocadoraDeVeículos.TelaPagamentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="PAGAMENTO" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="15">
                <TextBlock Text="DADOS CONSOLIDADOS" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                <Label Content="Nome do Cliente"/>
                <TextBlock x:Name="lblNomeCliente" FontSize="16" Margin="5,0,0,15"/>
                <Label Content="Veículo Selecionado"/>
                <TextBlock x:Name="lblVeiculoSelecionado" FontSize="16" Margin="5,0,0,15"/>
                <Label Content="Valor da Diária"/>
                <TextBlock x:Name="lblValorDiaria" FontSize="16" Margin="5,0,0,15"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="15">
                <Label Content="Dia Retirada"/>
                <DatePicker x:Name="dtpRetirada" SelectedDateChanged="PeriodoChanged" Margin="5"/>
                <Label Content="Dia Devolução"/>
                <DatePicker x:Name="dtpDevolucao" SelectedDateChanged="PeriodoChanged" Margin="5"/>
                <TextBlock Text="Método Pag:" Margin="5,15,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="rdbCartao" Content="Cartão" IsChecked="True" GroupName="MetodoPagamento" Checked="PeriodoChanged" Margin="5,0,20,0"/>
                    <RadioButton x:Name="rdbPix" Content="Pix" GroupName="MetodoPagamento" Checked="PeriodoChanged"/>
                </StackPanel>
                <TextBlock Text="VALOR FINAL" FontWeight="Bold" FontSize="18" Margin="5,25,0,5"/>
                <TextBlock x:Name="lblValorFinal" Text="R$ 0,00" FontSize="24" FontWeight="Bold" Margin="5"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="btnVoltar" Content="VOLTAR" Width="140" Height="38" Margin="5" Click="BtnVoltar_Click"/>
            <Button x:Name="btnConfirmar" Content="BTN CONFIRMAR" Width="160" Height="38" Margin="5" Click="BtnConfirmar_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
